{
  "$comment": "LIQWD design tokens as plain data — for Figma, email, non-Tailwind stacks, or feeding to an AI. Values match tokens.css exactly.",
  "color": {
    "brand": {
      "$comment": "Tailwind teal scale. The ONLY accent in the system — re-skin by replacing this ramp and nothing else.",
      "50": "#f0fdfa",
      "100": "#ccfbf1",
      "200": "#99f6e4",
      "300": "#5eead4",
      "400": "#2dd4bf",
      "500": "#14b8a6",
      "600": "#0d9488",
      "700": "#0f766e",
      "800": "#115e59",
      "900": "#134e4a"
    },
    "ink": {
      "$comment": "Near-black used for primary buttons, dark panels, headings and the wordmark.",
      "value": "#0b1220"
    },
    "text": {
      "body": "#0f172a",
      "secondary": "#475569",
      "muted": "#64748b",
      "faint": "#94a3b8",
      "onDark": "#ffffff"
    },
    "surface": {
      "page": "#ffffff",
      "subtle": "#f8fafc",
      "sunken": "#f1f5f9",
      "border": "#e2e8f0",
      "borderStrong": "#cbd5e1"
    },
    "semantic": {
      "success": { "bg": "#ecfdf5", "border": "#a7f3d0", "text": "#065f46" },
      "warning": { "bg": "#fffbeb", "border": "#fde68a", "text": "#92400e" },
      "danger": { "bg": "#fef2f2", "border": "#fecaca", "text": "#b91c1c" },
      "info": { "bg": "#f8fafc", "border": "#e2e8f0", "text": "#334155" }
    },
    "zones": {
      "$comment": "Color-coded intent zones for app navigation. See lib/section-accents.ts.",
      "brand": "start here / onboarding",
      "emerald": "make money / transact",
      "amber": "promote / spotlight",
      "sky": "explore / research",
      "slate": "account / manage"
    }
  },
  "typography": {
    "fonts": {
      "sans": "Geist — all body text and every app/dashboard surface",
      "display": "Inter Tight — h1/h2 on marketing + consumer surfaces only, via the .display-type wrapper",
      "mono": "Geist Mono"
    },
    "display": {
      "weight": 650,
      "letterSpacing": "-0.025em"
    },
    "scale": {
      "hero": "text-4xl sm:text-5xl, font-semibold, tracking-tight, text-balance",
      "pageTitle": "text-2xl font-semibold tracking-tight",
      "sectionTitle": "text-lg font-semibold",
      "cardTitle": "font-semibold",
      "body": "text-sm leading-relaxed (UI) · text-lg (marketing lede)",
      "meta": "text-xs text-slate-400",
      "kicker": "text-[10px] font-semibold uppercase tracking-[0.14em]",
      "eyebrow": "text-sm font-medium uppercase tracking-[0.18em] text-slate-400"
    }
  },
  "radius": {
    "control": "8px (rounded-lg) — buttons, inputs",
    "card": "12px (rounded-xl)",
    "panel": "16px (rounded-2xl) — zone headers, hero cards",
    "pill": "9999px (rounded-full) — badges, filter chips"
  },
  "elevation": {
    "card": "shadow-sm + border-slate-200",
    "hover": "group-hover:-translate-y-0.5 group-hover:shadow-lg, duration-300"
  },
  "spacing": {
    "pageStack": "space-y-6",
    "cardPadding": "p-5 (CardBody) · p-6 sm:p-8 (zone panels)",
    "containers": "max-w-3xl (article/form) · max-w-4xl (hub) · max-w-6xl (grid/browse)",
    "pagePadding": "px-6 py-12 sm:py-16 (public) · dashboard supplies its own"
  },
  "motion": {
    "default": "transition-colors",
    "cardHover": "transition-all duration-300",
    "reducedMotion": "Honour prefers-reduced-motion — the marquee disables itself."
  },
  "focus": {
    "$comment": "Never remove this. Global in tokens.css.",
    "value": "2px solid var(--color-brand-600), offset 2px"
  }
}
